// CARTHAGO : regles Firestore recommandees. A DEPLOYER PAR BAYRAM (Firebase Console > Firestore > Rules).
// Ce fichier n'est jamais deploye automatiquement. Il ne change pas la lecture/ecriture de users/{uid} (owner only)
// et AUTORISE la sous-collection de copies quotidiennes users/{uid}/backups (14 jours glissants).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /backups/{day} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
